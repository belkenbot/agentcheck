#!/usr/bin/env bash
#
#   agentcheck - find out what is going to break your agent setup, before it does.
#
#   Every check in this file came from something that actually broke on a real
#   production fleet: four machines, ninety-plus agents, running since March.
#   None of them are hypothetical. Each one has a date and a cost attached.
#
#   WHAT THIS DOES NOT DO, so you can run it without thinking twice:
#     - no network calls. none. grep the file.
#     - read-only. it never writes, moves, or deletes anything you own.
#     - nothing leaves your machine. there is no telemetry and no upload.
#     - it never prints the value of a secret, only the fact that one is exposed.
#
#   usage:  ./agentcheck              run every check
#           ./agentcheck --verbose    also show the checks that passed
#           ./agentcheck --plain      no colour (for piping or pasting)
#
#   Belken Ventures. Free. Keep it, fork it, hand it to whoever needs it.

set -uo pipefail

VERSION="1.1"
VERBOSE=0
PLAIN=0

for a in "$@"; do
  case "$a" in
    -v|--verbose) VERBOSE=1 ;;
    -p|--plain)   PLAIN=1 ;;
    -h|--help)    sed -n '2,19p' "$0" | sed 's/^#//;s/^ //'; exit 0 ;;
  esac
done

if [ "$PLAIN" = "1" ] || [ ! -t 1 ]; then
  R=""; G=""; Y=""; B=""; D=""; O=""
else
  R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; B=$'\033[1m'; D=$'\033[2m'; O=$'\033[0m'
fi

CRIT=0; WARN=0; PASS=0
FINDINGS=""

# fail <severity> <title> <what we found> <why it matters> <the fix>
fail() {
  local sev="$1" title="$2" found="$3" why="$4" fix="$5"
  case "$sev" in
    crit) CRIT=$((CRIT+1)); local tag="${R}${B}[ CRITICAL ]${O}" ;;
    *)    WARN=$((WARN+1)); local tag="${Y}${B}[ WARNING  ]${O}" ;;
  esac
  printf '%s %s%s%s\n' "$tag" "$B" "$title" "$O"
  printf '    %sfound%s   %s\n' "$D" "$O" "$found"
  printf '    %swhy%s     %s\n' "$D" "$O" "$why"
  printf '    %sfix%s     %s\n\n' "$D" "$O" "$fix"
}

ok() {
  PASS=$((PASS+1))
  [ "$VERBOSE" = "1" ] && printf '%s[ ok ]%s %s\n' "$G" "$O" "$1"
  return 0
}

skip() {
  [ "$VERBOSE" = "1" ] && printf '%s[ -- ]%s %s\n' "$D" "$O" "$1"
  return 0
}

SEC_OPEN=0; SEC_MARK=0

# an empty section reads as a broken tool, so say so explicitly when it is clean
close_section() {
  [ "$SEC_OPEN" = "1" ] || return 0
  [ $((CRIT+WARN)) -eq "$SEC_MARK" ] && printf '%s[ all clear ]%s nothing to fix here\n' "$G" "$O"
  SEC_OPEN=0
}

section() {
  close_section
  printf '\n%s%s%s\n%s\n' "$B" "$1" "$O" "$(printf '%.0s-' $(seq 1 ${#1}))"
  SEC_MARK=$((CRIT+WARN)); SEC_OPEN=1
}

have() { command -v "$1" >/dev/null 2>&1; }

# read a dotted key out of a json file without needing jq
jget() {
  local file="$1" path="$2"
  [ -f "$file" ] || return 1
  python3 - "$file" "$path" <<'PY' 2>/dev/null
import json,sys
try:
    d=json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
for k in sys.argv[2].split('.'):
    if isinstance(d,dict) and k in d: d=d[k]
    else: sys.exit(1)
if isinstance(d,(dict,list)): print(json.dumps(d))
elif isinstance(d,bool): print('true' if d else 'false')
else: print(d)
PY
}

# ---------------------------------------------------------------- discovery

CLAUDE_DIR="$HOME/.claude"
OC_DIR="$HOME/.openclaw"
OC_CFG="$OC_DIR/openclaw.json"
CODEX_DIR="$HOME/.codex"

FOUND_ANY=0
STACKS=""
[ -d "$CLAUDE_DIR" ] && { FOUND_ANY=1; STACKS="$STACKS Claude-Code"; }
[ -d "$OC_DIR"     ] && { FOUND_ANY=1; STACKS="$STACKS OpenClaw"; }
[ -d "$CODEX_DIR"  ] && { FOUND_ANY=1; STACKS="$STACKS Codex"; }
[ -d "$HOME/.cursor" ] && { FOUND_ANY=1; STACKS="$STACKS Cursor"; }

printf '\n%sagentcheck v%s%s  %s- what is going to break your agent setup%s\n' "$B" "$VERSION" "$O" "$D" "$O"
printf '%sread-only, offline, nothing leaves this machine%s\n' "$D" "$O"

if [ "$FOUND_ANY" = "0" ]; then
  printf '\n%sNo agent stack found in your home directory.%s\n' "$Y" "$O"
  printf 'Looked for: ~/.claude, ~/.openclaw, ~/.codex, ~/.cursor\n'
  printf 'Run this on the machine your agents actually live on.\n\n'
  exit 0
fi
printf 'detected:%s\n' "$STACKS"

# ---------------------------------------------------------------- 1. memory

section "1. MEMORY  -  will your agent still know this tomorrow"

MEM_LAYER=0
for f in "$CLAUDE_DIR/CLAUDE.md" "$HOME/CLAUDE.md" "$OC_DIR/workspace/MEMORY.md" "$OC_DIR/workspace/AGENTS.md" "$CODEX_DIR/AGENTS.md" "$HOME/.cursorrules"; do
  [ -f "$f" ] && MEM_LAYER=1
done
[ -d "$HOME/.cursor/rules" ] && MEM_LAYER=1

if [ "$MEM_LAYER" = "0" ]; then
  fail crit "No durable memory file anywhere" \
    "no CLAUDE.md, AGENTS.md or MEMORY.md in any detected stack" \
    "Everything your agent learns dies at the end of the session. You will re-explain your own project to it every single day, forever, and pay tokens for the privilege." \
    "Create ONE file (CLAUDE.md or AGENTS.md) at your project root. Put in it: where truth lives, the rules that must not drift, and the traps that already cost you time."
else
  ok "durable memory file present"
  # size trap: oversized memory files get silently truncated at load
  for f in "$CLAUDE_DIR/CLAUDE.md" "$HOME/CLAUDE.md" "$OC_DIR/workspace/MEMORY.md" "$OC_DIR/workspace/AGENTS.md" "$CODEX_DIR/AGENTS.md" "$HOME/.cursorrules"; do
    [ -f "$f" ] || continue
    sz=$(wc -c < "$f" | tr -d ' ')
    if [ "$sz" -gt 24000 ]; then
      fail crit "Memory file is past the truncation cliff" \
        "$(basename "$f") is ${sz} bytes" \
        "Long context files get cut off at load and the tail is dropped silently. No error, no warning. The rules at the bottom of that file are not reaching the model and you have no way to tell from the outside." \
        "Get it under ~17KB. Turn it into an index of one-line pointers and move the depth into separate topic files it can open on demand."
    elif [ "$sz" -gt 17000 ]; then
      fail warn "Memory file is approaching the truncation cliff" \
        "$(basename "$f") is ${sz} bytes" \
        "Past roughly 24KB the tail is dropped at load with no error. You are close enough that one more good session pushes you over." \
        "Split it now, while it is still cheap. Index at the top, depth in linked files."
    else
      ok "$(basename "$f") is a safe size (${sz}b)"
    fi
  done
fi

# a memory file full of live facts rots. check for a source of truth pointer.
# same file set as the existence check above: an OpenClaw or Codex box keeps its
# primary instructions in AGENTS.md, so leaving it out let this check silently
# no-op on exactly the stacks most likely to run it. .cursorrules covers Cursor users.
for f in "$CLAUDE_DIR/CLAUDE.md" "$HOME/CLAUDE.md" "$OC_DIR/workspace/MEMORY.md" "$OC_DIR/workspace/AGENTS.md" "$CODEX_DIR/AGENTS.md" "$HOME/.cursorrules"; do
  [ -f "$f" ] || continue
  if grep -qiE 'source of truth|query|do not trust|verify' "$f" 2>/dev/null; then
    ok "$(basename "$f") points at a source of truth instead of copying facts"
  else
    fail warn "Memory file stores facts instead of pointing at them" \
      "$(basename "$f") has no source-of-truth or verify instruction" \
      "Anything you hardcode into a memory file goes stale and then gets asserted back to you with total confidence months later. A wrong memory is worse than no memory because you stop checking." \
      "Add a line at the top naming where live facts live, and instruct the agent to query it rather than trust the copy in the file."
  fi
done

# ---------------------------------------------------------------- 2. cost

section "2. COST  -  what you are paying for work that does not need it"

BIG_MODEL=""
if [ -f "$OC_CFG" ]; then
  BIG_MODEL="$(jget "$OC_CFG" agents.main.model 2>/dev/null || true)"
  [ -z "$BIG_MODEL" ] && BIG_MODEL="$(jget "$OC_CFG" model 2>/dev/null || true)"
fi

HAS_LOCAL=0
have ollama && HAS_LOCAL=1
[ -d "$HOME/.ollama" ] && HAS_LOCAL=1
have lms && HAS_LOCAL=1
[ -d "$HOME/.lmstudio" ] && HAS_LOCAL=1
# a local model on another box on your own network still counts
for f in "$OC_CFG" "$CLAUDE_DIR/settings.json" "$HOME/.mcp.json" "$CODEX_DIR/config.toml"; do
  [ -f "$f" ] || continue
  grep -qiE 'ollama|lmstudio|llama\.cpp|:11434|:1234/v1|:8080/v1' "$f" 2>/dev/null && HAS_LOCAL=1
done

if [ "$HAS_LOCAL" = "0" ]; then
  fail warn "Every task goes to a paid frontier model" \
    "no local model runtime detected (ollama / lm studio / local endpoint)" \
    "Summarising, tagging, classifying, formatting and routing are the bulk of agent traffic and none of it needs a frontier model. Fleets that route the cheap work locally cut their monthly bill by roughly an order of magnitude without losing anything that matters." \
    "Install ollama, pull one small instruct model, and point your summarise/classify/tag jobs at it. Keep the expensive model for reasoning and code."
else
  ok "local model runtime available for cheap work"
fi

# fallback chain
if [ -f "$OC_CFG" ]; then
  if grep -qi 'fallback' "$OC_CFG" 2>/dev/null; then
    ok "fallback model chain configured"
  else
    fail warn "No fallback model configured" \
      "no fallback chain in openclaw.json" \
      "When your provider rate-limits or your quota runs out mid-task, the run dies where it stands. If it was a cron or an unattended job, it dies silently and you find out days later." \
      "Configure at least one fallback model. Then test it by deliberately breaking the primary, because an untested fallback is not a fallback."
  fi
fi

# ---------------------------------------------------------------- 3. blast radius

section "3. BLAST RADIUS  -  what your agent can do that you have not thought about"

GUARD=0
for f in "$CLAUDE_DIR/CLAUDE.md" "$HOME/CLAUDE.md" "$OC_DIR/workspace/AGENTS.md" "$OC_DIR/workspace/SOUL.md" "$CODEX_DIR/AGENTS.md"; do
  [ -f "$f" ] || continue
  grep -qiE 'never|do not|approval|ask (me|first)|without (my |explicit )?(approval|permission)' "$f" 2>/dev/null && GUARD=1
done

if [ "$GUARD" = "0" ]; then
  fail crit "No written approval gate anywhere" \
    "no instruction file forbids anything or requires approval" \
    "Your agent has your shell, your keys and your accounts, and nothing on record tells it where to stop. The first time it decides a destructive command is the efficient path, it is right by its own reasoning and you find out afterward." \
    "Write four lines into your instruction file. Nothing gets published, sent, purchased or deleted without an explicit yes. Name them individually. Vague caution does not survive a confident plan."
else
  ok "approval gates written down"
fi

# permission allowlist with a blanket wildcard
for sf in "$CLAUDE_DIR/settings.json" "$CLAUDE_DIR/settings.local.json"; do
  [ -f "$sf" ] || continue
  if grep -qE '"Bash\(\*\)"|"Bash\(\*:\*\)"|"\*"' "$sf" 2>/dev/null; then
    fail crit "Blanket wildcard in your permission allowlist" \
      "$(basename "$sf") pre-approves all commands" \
      "You have turned off the one thing standing between a plausible-looking plan and rm -rf on the wrong path. Approval prompts feel like friction right up until the run they save." \
      "Delete the wildcard. Allowlist specific commands you actually run. Take the prompts for everything else."
  else
    ok "$(basename "$sf") has no blanket wildcard"
  fi
done

# auto-run / yolo flags
if [ -f "$OC_CFG" ]; then
  for k in exec.elevated autoApprove dangerouslySkipPermissions yolo; do
    v="$(jget "$OC_CFG" "$k" 2>/dev/null || true)"
    if [ "$v" = "true" ]; then
      fail crit "Unattended execution is globally enabled" \
        "$k is true in openclaw.json" \
        "Every scheduled job, every webhook and every background agent now runs commands with nobody watching. This is the setting that turns one bad inference into an incident." \
        "Turn it off globally. Enable it per-session, deliberately, for the ten minutes you actually need it."
    fi
  done
fi

# scheduled jobs writing into live sessions.
# only fires on real job definitions, never on the mere presence of a config key.
# current OpenClaw keeps jobs in the SQLite state db (state/openclaw.sqlite);
# older installs kept them in cron/jobs.json, which an upgrade archives to a
# .migrated name. read both, or an upgraded box passes this critical silently.
OC_STATE_DB="$OC_DIR/state/openclaw.sqlite"
CRON_UNSAFE=$(python3 - "$OC_CFG" "$OC_DIR/cron/jobs.json" "$OC_STATE_DB" <<'PY' 2>/dev/null
import json,sys,os,sqlite3
cfg,legacy,db = sys.argv[1],sys.argv[2],sys.argv[3]
def unsafe(j):
    if j.get('payload',{}).get('kind') == 'heartbeat': return False
    return str(j.get('sessionTarget','')).lower() not in ('isolated','new')
bad=0
# legacy job definitions living in json (openclaw.json + cron/jobs.json)
jobs=[]
for p in (cfg,legacy):
    if not os.path.isfile(p): continue
    try: d=json.load(open(p))
    except Exception: continue
    def walk(x):
        if isinstance(x,list):
            for i in x: walk(i)
        elif isinstance(x,dict):
            if ('schedule' in x or 'cron' in x) and ('prompt' in x or 'systemEvent' in x or 'agent' in x or 'sessionKey' in x):
                jobs.append(x)
            for v in x.values(): walk(v)
    walk(d)
bad += sum(1 for j in jobs if unsafe(j))
# current store: the shared sqlite state db, table cron_jobs, one job per row
if os.path.isfile(db):
    try:
        con=sqlite3.connect(f"file:{db}?mode=ro",uri=True,timeout=2)
        rows=con.execute("select job_json from cron_jobs").fetchall()
        con.close()
        for (jj,) in rows:
            try: j=json.loads(jj)
            except Exception: continue
            if not j.get('enabled'): continue   # a disabled job never runs
            if unsafe(j): bad+=1
    except Exception:
        pass
print(bad)
PY
)
if [ "${CRON_UNSAFE:-0}" -gt 0 ]; then
  fail crit "Scheduled jobs are not isolated from your live sessions" \
    "${CRON_UNSAFE} scheduled job(s) do not run in an isolated session" \
    "A scheduled job that lands inside a live conversation injects a different model into that context and forces a compaction. The visible symptom is your agent losing its memory for no reason, days later, and it is almost impossible to trace back to the cron that caused it." \
    "Set every scheduled job to run isolated. No exceptions, including the ones that look harmless."
elif [ -f "$OC_STATE_DB" ] || [ -f "$OC_DIR/cron/jobs.json" ] || [ -f "$OC_CFG" ]; then
  ok "no scheduled job is writing into a live session"
fi

# ---------------------------------------------------------------- 4. secrets

section "4. SECRETS  -  what is sitting in the open"

LEAKY=0
for f in "$OC_CFG" "$CLAUDE_DIR/settings.json" "$CLAUDE_DIR/settings.local.json" "$CLAUDE_DIR/.mcp.json" "$HOME/.mcp.json" "$CODEX_DIR/config.toml"; do
  [ -f "$f" ] || continue
  if grep -qiE '"?(api_?key|token|secret|password|bearer)"?[[:space:]]*[:=][[:space:]]*"?(sk-|xox|gh[pous]_|AKIA|eyJ|[A-Za-z0-9_\-]{24,})' "$f" 2>/dev/null; then
    perms=$(ls -l "$f" 2>/dev/null | cut -c1-10)
    # safe = no group-read (char 5) and no other-read (char 8). matching only
    # 600 flagged modes that are *stricter* -- 400 (-r--------) and 700
    # (-rwx------) have no group/other access at all, yet the old
    # '^-rw-------' test called them world-readable and told the user to
    # chmod 600 a file already locked down tighter than that.
    if printf '%s' "$perms" | grep -qE '^-[-rwx]{3}-[-rwx]{2}-[-rwx]{2}$'; then
      ok "$(basename "$f") holds credentials but is owner-only"
    else
      LEAKY=1
      fail crit "Credentials in a world-readable file" \
        "$(basename "$f") contains a secret and its mode is $perms" \
        "Any process, any other user, and anything you paste into a chat window can read that. The usual way this leaks is not an attacker, it is you pasting a config for help and not noticing what was in line 40." \
        "chmod 600 '$f' now. Then move the values into your keychain or an env file and reference them, so the config is safe to share."
    fi
  fi
done
[ "$LEAKY" = "0" ] && ok "no world-readable credential files found"

# secrets committed to a git repo
for wd in "$OC_DIR/workspace" "$PWD"; do
  [ -d "$wd/.git" ] || continue
  if [ -f "$wd/.env" ] && ! grep -qE '(^|/)\.env' "$wd/.gitignore" 2>/dev/null; then
    fail crit "A .env file sits in a git repo and is not ignored" \
      "$wd/.env is not covered by .gitignore" \
      "One git add -A and your keys are in history. Rotating them afterward is the easy part. Finding every clone and every fork is not." \
      "Add .env to .gitignore, then confirm it is not already committed before you relax."
  else
    # .env is absent or in .gitignore — it may still be tracked in git history
    if have git && git -C "$wd" ls-files --error-unmatch ".env" >/dev/null 2>&1; then
      fail crit ".env is committed to your git history" \
        "$wd/.env is tracked by git despite being ignored or absent" \
        ".gitignore stops future commits but does not rewrite history. Everyone with a clone of this repo has a copy of the secrets it held when it was committed. If you pushed it, assume it is compromised." \
        "Rotate every secret in .env now. Remove it from history: git filter-repo --path .env --invert-paths (or BFG Repo-Cleaner). Add .env to .gitignore if not already done."
    else
      ok "$(basename "$wd") repo has no exposed .env"
    fi
  fi
done

# ---------------------------------------------------------------- 5. durability

section "5. DURABILITY  -  what an update or a reboot takes out"

# config backup
# a dated/.bak copy beside the file OR the config tracked in git both count.
# without the git arm this check nagged the exact user who took its own advice
# ("put the whole config directory in a private git repo") -- a false warning
# on the best-practice setup.
if [ -f "$OC_CFG" ]; then
  if ls "$OC_DIR"/openclaw.json.* >/dev/null 2>&1 || ls "$OC_DIR"/*.bak >/dev/null 2>&1; then
    ok "config has at least one backup beside it"
  elif have git && git -C "$OC_DIR" ls-files --error-unmatch "$(basename "$OC_CFG")" >/dev/null 2>&1; then
    ok "config file is tracked in git (version-controlled backup)"
  else
    fail warn "No backup of your agent config" \
      "openclaw.json has no .bak or dated copy" \
      "This file is the accumulated result of every fix you have ever made. One bad patch, one failed merge, one overwrite, and you rebuild months of tuning from memory." \
      "Copy it now with today's date in the name. Better, put the whole config directory in a private git repo."
  fi
fi

# patched dist files that an update will silently wipe
for base in "$HOME/.npm-global/lib/node_modules" "/usr/local/lib/node_modules" "/opt/homebrew/lib/node_modules"; do
  [ -d "$base" ] || continue
  n=$(find "$base" -maxdepth 4 -name '*.bak-*' 2>/dev/null | wc -l | tr -d ' ')
  if [ "$n" -gt 0 ]; then
    fail warn "You have hand-patched an installed package" \
      "$n backup file(s) under $base indicate edited vendor code" \
      "The next update overwrites your patch and takes the behaviour with it. It fails silently, the tool still runs, and the thing you fixed quietly comes back weeks later while you swear it was working." \
      "Write down what you patched and why, and add a one-line check that runs after every update to confirm the patch is still there."
  fi
done

# node version dead zone
if have node; then
  NV="$(node -v 2>/dev/null | tr -d 'v')"
  NMAJ="${NV%%.*}"
  NMIN="$(printf '%s' "$NV" | cut -d. -f2)"
  if [ "$NMAJ" = "24" ] && [ "${NMIN:-0}" -lt 15 ]; then
    fail crit "Node is in a known dead zone" \
      "node v$NV" \
      "Several agent toolchains declare their support as separate version ranges rather than one floor. Versions that fall in the gap between ranges hard-fail on install with an error that looks like a broken package rather than a version problem, and you can lose an evening to it." \
      "Move to node 24.15 or newer, then reinstall your agent CLI under that same version."
  else
    ok "node v$NV is outside the known dead zone"
  fi
fi

# session sprawl
for sdir in "$CLAUDE_DIR/projects" "$OC_DIR/agents"; do
  [ -d "$sdir" ] || continue
  sz=$(du -sm "$sdir" 2>/dev/null | cut -f1)
  [ -z "$sz" ] && continue
  if [ "$sz" -gt 2000 ]; then
    fail warn "Session history is consuming real disk" \
      "$(basename "$sdir") is ${sz} MB" \
      "Transcript sprawl is the quiet way an agent machine fills up, and a full disk takes down the gateway, the database and the browser profiles at the same moment, which reads as five unrelated failures." \
      "Prune or archive transcripts older than a month. Keep the ones you actually mine for lessons."
  else
    ok "$(basename "$sdir") disk use is sane (${sz} MB)"
  fi
done

# free space
# -P forces POSIX single-line-per-filesystem output; without it GNU df wraps a
# long device name (LVM / encrypted / network mounts) onto its own line, NR==2
# lands on that wrap, $4 is empty, and this critical silently never fires.
FREE=$(df -Pm "$HOME" 2>/dev/null | awk 'NR==2{print $4}')
if [ -n "${FREE:-}" ]; then
  if [ "$FREE" -lt 10000 ]; then
    fail crit "Under 10 GB free on the agent machine" \
      "${FREE} MB free" \
      "Agents write constantly: transcripts, caches, model files, browser profiles, container layers. When the disk fills, everything fails at once and none of the errors mention disk." \
      "Clear space now. Then move heavy compute, media and containers off this box onto whatever machine has the room."
  else
    ok "free disk is adequate (${FREE} MB)"
  fi
fi

# ---------------------------------------------------------------- 6. observability

section "6. OBSERVABILITY  -  would you know if it stopped"

HEALTH=0
if have crontab && crontab -l 2>/dev/null | grep -qiE 'health|check|monitor|heartbeat|alert'; then HEALTH=1; fi
if [ -f "$OC_CFG" ] && grep -qiE 'heartbeat|healthcheck|alert' "$OC_CFG" 2>/dev/null; then HEALTH=1; fi
ls "$HOME/Library/LaunchAgents"/*.plist >/dev/null 2>&1 && \
  grep -liE 'health|monitor|heartbeat' "$HOME/Library/LaunchAgents"/*.plist >/dev/null 2>&1 && HEALTH=1
# Linux: a systemd timer is the OS scheduler, the same role cron and launchd play.
# checked only against timers (admin-defined scheduled jobs) so stock system
# timers -- apt-daily, logrotate, man-db, fstrim, e2scrub -- cannot false-pass this.
if have systemctl && systemctl list-timers --all --no-legend 2>/dev/null | grep -qiE 'health|monitor|heartbeat|healthcheck|alert'; then HEALTH=1; fi

if [ "$HEALTH" = "0" ]; then
  fail warn "Nothing tells you when an agent stops working" \
    "no heartbeat, health check or alerting job found" \
    "A dead agent is indistinguishable from an idle one. The expensive version of this is not a crash, it is a scheduled job that has been failing since a config change and nobody noticed for weeks." \
    "Add one job that checks the thing you care about and messages you when it is wrong. One check that actually alerts you beats a dashboard you never open."
else
  ok "some form of health monitoring exists"
fi

# a scheduled job that swallows its own errors
# match only redirects that actually discard STDERR: 2>/dev/null, &>/dev/null,
# >&/dev/null, or >/dev/null 2>&1. a plain >/dev/null silences stdout only and
# leaves stderr flowing to cron mail, so counting it told the user a job that can
# still fail loudly was throwing its errors away -- a false positive.
if have crontab; then
  SILENT=$(crontab -l 2>/dev/null | grep -cE '2>[[:space:]]*/dev/null|[&]>[[:space:]]*/dev/null|>&[[:space:]]*/dev/null|/dev/null[[:space:]]+2>&1' || true)
  if [ "${SILENT:-0}" -gt 0 ]; then
    fail warn "Scheduled jobs are discarding their errors" \
      "${SILENT} cron entr(y/ies) redirect output to /dev/null" \
      "A job that throws away stderr cannot fail loudly. It fails quietly for months instead. The single most expensive class of bug on any fleet is the error nobody was shown." \
      "Send output to a log file instead of /dev/null, and alert on non-zero exit."
  else
    ok "cron jobs are not discarding errors"
  fi
fi

# ---------------------------------------------------------------- verdict

close_section

TOTAL=$((CRIT+WARN))
printf '\n%s%s%s\n' "$B" "----------------------------------------------------------" "$O"
if [ "$CRIT" -gt 0 ]; then
  printf '%s%s%d critical%s and %s%d warning%s across %d checks.\n' "$B" "$R" "$CRIT" "$O" "$Y" "$WARN" "$O" "$((TOTAL+PASS))"
  printf 'Fix the critical ones first. Each is something that has already taken down a real fleet.\n'
elif [ "$WARN" -gt 0 ]; then
  printf '%sNo critical findings.%s %s%d warning(s)%s across %d checks.\n' "$G" "$O" "$Y" "$WARN" "$O" "$((TOTAL+PASS))"
  printf 'You are in better shape than most. The warnings are the ones that bite in month three.\n'
else
  printf '%sClean across %d checks.%s That is rare. Run it again after your next big change.\n' "$G" "$((TOTAL+PASS))" "$O"
fi
printf '%s%s%s\n\n' "$B" "----------------------------------------------------------" "$O"

printf '%sWhere these checks came from%s\n' "$B" "$O"
printf 'A four-machine agent fleet running since March: ninety-plus agents, a shared\n'
printf 'Postgres memory layer, cron orchestration, browser automation. Every check above\n'
printf 'is a failure that actually happened there, with a date and a cost attached.\n\n'
printf 'The full writeup of what broke and how it got fixed:\n'
printf '  %shttps://belken.ai/field-manual%s\n\n' "$B" "$O"
printf '%sagentcheck is free and always will be. Pass it to whoever needs it.%s\n\n' "$D" "$O"

exit 0
